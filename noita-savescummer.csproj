<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>NoitaSaveScummer</RootNamespace>
    <AssemblyName>noita-savescummer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Windows-only target (Noita is Windows-only) -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>

    <!-- Release builds are trimmed. Fail fast in every configuration on reflection-based JSON
         and surface trim problems at build time instead of at runtime. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>

    <AssemblyTitle>Noita Save Scummer</AssemblyTitle>
    <Description>Automated backup and restoration tool for Noita game saves (Windows)</Description>
    <Company>colinmxs</Company>
    <Product>Noita Save Scummer</Product>
    <Copyright>Copyright © 2025 colinmxs</Copyright>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoitaSaveScummer.Tests" />
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
